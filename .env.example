# E-post (Gmail med app-password) — brukes av både kjøpsflyt og kontaktskjema
# Slik lager du et Gmail app-password:
#   Google Account -> Security -> 2-Step Verification (slå på) ->
#   App passwords -> create -> velg "Mail" + "Other" -> kopier passordet (16 tegn).
# GMAIL_ADDRESS er din Gmail-adresse, GMAIL_APP_PASSWORD er det 16-tegns app-passordet.
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Mottaker (deg) for både kjøpsregistreringer og kontaktskjema — f.eks. samme Gmail-adresse
PURCHASE_RECEIVER=your@gmail.com

# Cloudflare Turnstile (spam-beskyttelse for kontaktskjema)
# Slik lager du nøkler: Cloudflare Dashboard -> Turnstile -> Add site -> kopier samen.
# NEXT_PUBLIC_TURNSTILE_SITEKEY (offentlig, gå i nettleser) + CLOUDFLARE_TURNSTILE_SECRET_KEY (hemmelig).
NEXT_PUBLIC_TURNSTILE_SITEKEY=your-cloudflare-sitekey
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-cloudflare-secret
