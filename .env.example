# E-post for kjøpsregistrering (Gmail med app-password)
# Slik lager du et Gmail app-password:
#   Google Account -> Security -> 2-Step Verification (slå på) ->
#   App passwords -> create -> velg "Mail" + "Other" -> kopier passordet (16 tegn).
# GMAIL_ADDRESS er din Gmail-adresse, GMAIL_APP_PASSWORD er det 16-tegns app-passordet.
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Mottaker (deg) for kjøpsregistreringer — f.eks. samme Gmail-adresse
PURCHASE_RECEIVER=your@gmail.com

# Gammel kontaktform (api/contact.ts) uten denne er skjemaet ikke i drift:
# SMTP_HOST=your-smtp-host
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# CONTACT_RECEIVER=your@email.com
# CLOUDFLARE_TURNSTILE_SECRET_KEY=...
# NEXT_PUBLIC_TURNSTILE_SITEKEY=...
